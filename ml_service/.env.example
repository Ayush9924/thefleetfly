# FleetFly ML Service MongoDB Configuration
# Connection string pointing to your MongoDB instance (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/fleetdb
# Alternative variable name supported by existing FleetFly config
MONGO_URI=mongodb://localhost:27017/fleetdb

# Database name (default: fleetdb)
DB_NAME=fleetdb

# Execution mode: 'cloud' (connect to URI) or 'local_demo' (safe local/mock mode)
ML_MODE=cloud

