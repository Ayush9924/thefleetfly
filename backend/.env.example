PORT=5001
MONGO_URI=mongodb://localhost:27017/fleetdb
JWT_SECRET=your_strong_secret_here
JWT_EXPIRE=30d
UPLOADS_DIR=./uploads

# Email provider (production)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=FleetFly <no-reply@your-domain.com>

# Optional SMTP fallback (not recommended on Render Free)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
ALLOW_SMTP_FALLBACK=false