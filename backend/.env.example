PORT=5001
MONGO_URI=mongodb://localhost:27017/fleetdb
JWT_SECRET=your_strong_secret_here
JWT_EXPIRE=30d
UPLOADS_DIR=./uploads

# Email provider (production)
MAIL_PROVIDER=smtp

# SMTP settings (required when MAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
MAIL_FROM=FleetFly <your_email@gmail.com>

# Optional Resend settings (only if MAIL_PROVIDER=resend or auto)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=FleetFly <no-reply@your-domain.com>